{
  "version": "0.2.0",
  "configurations": [
    {
      // integratedTerminal is required: main.py blocks on input() for chat
      // and for the [y/n] approval prompt raised by approval_node.
      "name": "Financial Assistant (CLI)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    },
    {
      // --no-reload matters: hot reload respawns the server in a child process
      // that the debugger never attaches to, so breakpoints silently never hit.
      "name": "LangGraph dev server",
      "type": "debugpy",
      "request": "launch",
      "module": "langgraph_cli",
      "args": ["dev", "--no-reload"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false
    }
  ]
}
