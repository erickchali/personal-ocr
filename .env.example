# Manual installs for checking: uv, docker, docker compose

# ============================================================
# OpenRouter — the single LLM gateway
# One key for every vendor. Get it from openrouter.ai/keys
# ============================================================
OPENROUTER_API_KEY='{your-key}'
TAVILY_API_KEY='{your-key}'

# Optional: shows this app in your OpenRouter dashboard rankings
OPENROUTER_APP_TITLE=financial-assistant
# OPENROUTER_APP_URL=https://github.com/erickchali/personal-ocr

# ============================================================
# Model per scenario
#
# Every node picks its model by ROLE, not by vendor. Each var
# takes an OpenRouter model slug (see openrouter.ai/models).
# Resolution order:  LLM_MODEL_<ROLE>  ->  LLM_MODEL_DEFAULT  ->  built-in
# Swapping any model is a one-line change here — no code edit.
# ============================================================
LLM_MODEL_DEFAULT=google/gemini-2.5-flash

# Long statements + a large nested schema -> favour a strong, long-context model
LLM_MODEL_EXTRACTION=google/gemini-2.5-pro

# Trivial 3-way intent classification -> cheapest tier is plenty
LLM_MODEL_ROUTER=google/gemini-2.5-flash-lite

# Text-to-SQL over the toolkit -> needs the strongest tool-calling
LLM_MODEL_QUERY=anthropic/claude-sonnet-4.5

# Plain conversational replies
LLM_MODEL_RESPOND=google/gemini-2.5-flash

# ============================================================
# LangSmith (tracing / observability)
# ============================================================
LANGSMITH_API_KEY='{your-key}'
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=learning-path

# ============================================================
# Docker services — Host ports
# Change these if the defaults conflict with other processes.
# ============================================================
POSTGRES_HOST_PORT=5432
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
METABASE_HOST_PORT=3000

# ============================================================
# Postgres
# ============================================================
POSTGRES_USER=financial_assistant
POSTGRES_PASSWORD=financial_assistant_pw
POSTGRES_DB=financial_assistant
POSTGRES_HOST=localhost
DATABASE_URL=postgresql://financial_assistant:financial_assistant_pw@localhost:5432/financial_assistant
DATABASE_READ_URL=postgresql://query_reader:query_reader_pw@localhost:5432/financial_assistant

# ============================================================
# MinIO (S3-compatible object storage)
# ============================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Where uploaded statement PDFs live. Defaults to localhost:$MINIO_API_HOST_PORT,
# so only set MINIO_ENDPOINT_URL if MinIO is somewhere else.
# MINIO_ENDPOINT_URL=http://localhost:9000
STATEMENTS_BUCKET=statements
